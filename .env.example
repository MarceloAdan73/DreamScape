# =============================================================================
# DreamScape - variables de entorno
# Copiar a `.env` (nunca commitear el .env real). El .env está en .gitignore.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
# Orígenes CORS del frontend (formato JSON list).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DEBUG=false

# --- Base de datos -----------------------------------------------------------
# Por defecto SQLite async. Ruta relativa al directorio backend/.
# DATABASE_URL=sqlite+aiosqlite:///./data/dreamscape.db

# --- Proveedor de IA ---------------------------------------------------------
# REGLA DE ORO: "ollama" es local y es el default. "openai" es un fallback
# EXPLÍCITO contra una API compatible (OpenAI, Groq, Together, etc.).
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.7

# Ollama (100% local, sin nube).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI-compatible (solo si LLM_PROVIDER=openai).
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# --- ChromaDB (vector store embebido) ---------------------------------------
# CHROMA_PATH=./data/chroma
# CHROMA_COLLECTION=dreams

# --- Similitud entre sueños --------------------------------------------------
SIMILARITY_THRESHOLD=0.45
SIMILAR_TOP_K=5
